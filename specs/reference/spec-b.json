{
  "bank_name": "Freya Bank",
  "assistant_identity": "Freya Bank's digital assistant",
  "address_as": "{title} {last_name}",
  "call_variables": [
    "customer_id",
    "first_name",
    "last_name",
    "title",
    "now"
  ],
  "opening": {
    "first_sentence": "Hello, this is a digital assistant calling from Freya Bank. This call is being recorded for quality and security purposes.",
    "confirm_question": "Am I speaking with {title} {last_name}?",
    "confirm_accept": [
      "yes",
      "that's me",
      "speaking",
      "their own name"
    ],
    "confirm_reject": [
      "hello",
      "go ahead",
      "who is this"
    ],
    "max_asks": 2,
    "banned_before_verify": [
      "collections",
      "debt",
      "payment",
      "credit card",
      "personal loan",
      "car loan",
      "amount"
    ]
  },
  "third_party": {
    "say_nothing_beyond_opening": true,
    "callback": {
      "days": [
        "today",
        "next_business_day"
      ],
      "from": "10:00",
      "to": "19:00",
      "inclusive": true,
      "after_now": true
    },
    "window_retries": 1,
    "fixed_sentences": {
      "deceased": "I am sorry for your loss."
    }
  },
  "identity": {
    "questions": [
      {
        "field": "date_of_birth",
        "ask": "What is your date of birth?",
        "format": "date",
        "date_order": "DMY"
      },
      {
        "field": "phone_last4",
        "ask": "What are the last four digits of the phone number on file?",
        "format": "digits",
        "length": 4
      }
    ],
    "max_wrong": 3,
    "wrong_scope": "total",
    "non_counting_hints": {
      "day_month_swapped": "Ask them to say the month as a word."
    },
    "decline_explanation": "These questions protect your account.",
    "decline_limit": 2,
    "failed_advice": "Please use the mobile app or visit a branch."
  },
  "calendar": {
    "weekdays": [
      0,
      1,
      2,
      3,
      4
    ],
    "holidays": [
      "2026-10-26",
      "2026-11-11",
      "2026-11-26",
      "2026-12-25",
      "2027-01-01"
    ]
  },
  "products": {
    "credit_card": {
      "words": "credit card ending {card_last4}",
      "floor_field": "minimum_payment"
    },
    "personal_loan": {
      "words": "personal loan",
      "floor_field": "instalment_amount"
    },
    "car_loan": {
      "words": "car loan",
      "floor_field": "instalment_amount"
    }
  },
  "bands": [
    {
      "name": "early",
      "days_late": [
        1,
        7
      ],
      "deadline": {
        "rule": "nth_business_day",
        "n": 12
      },
      "attempts": [
        {
          "amount": "current",
          "date": "last_business_day_of_week"
        }
      ]
    },
    {
      "name": "late",
      "days_late": [
        8,
        45
      ],
      "deadline": {
        "rule": "nth_business_day",
        "n": 7
      },
      "attempts": [
        {
          "amount": "current",
          "date": "last_business_day_of_week"
        },
        {
          "amount": "floor",
          "date": "deadline"
        }
      ]
    }
  ],
  "negotiation": {
    "debt_statement": "I am calling from the collections team about a late payment on your {product_words}. The past-due amount is {past_due}, and it is {days_late} days late.",
    "first_ask": "Can you make this payment today?",
    "floor_offer": {
      "times": 1,
      "sentence_suffix": "The rest stays overdue."
    },
    "below_floor": "offer_floor_once",
    "vague_date": "ask_once_then_deadline",
    "weekday_words": {
      "next": "following_week",
      "this": "current_week"
    },
    "non_business_day": "next_business_day",
    "after_deadline": "offer_deadline",
    "never_ask_how_much": true,
    "banned_offers": [
      "discount",
      "waiver",
      "instalment plan"
    ],
    "debt_statement_per_product": "Your {product_words} is {days_late} days late, with {past_due} past due.",
    "first_ask_all": "Can you pay all of them today?"
  },
  "events": [
    {
      "say": null,
      "outcome": "promise",
      "reason": null,
      "id": "promise_recorded",
      "trigger": "create_promise returned ok: true for at least one product",
      "stages": [
        "negotiate"
      ],
      "action": "close"
    },
    {
      "say": "Payments can take one business day to appear.",
      "outcome": "paid",
      "reason": null,
      "id": "paid",
      "trigger": "says they already paid this past-due amount on a product (not a claim that the product was closed or paid off in the past)",
      "stages": [
        "negotiate"
      ],
      "instruction": "Take no promise.",
      "action": "note_and_continue",
      "per_product_note": "paid"
    },
    {
      "say": null,
      "outcome": "no_promise",
      "reason": "dispute",
      "id": "dispute",
      "trigger": "says a debt is not theirs, they never had a product, or a product was closed or paid off in the past",
      "stages": [
        "negotiate"
      ],
      "instruction": "Do not argue and do not take a promise.",
      "action": "note_and_continue",
      "per_product_note": "dispute"
    },
    {
      "say": null,
      "outcome": "transferred",
      "reason": "restructuring",
      "id": "restructuring",
      "trigger": "asks for a new payment plan or lower instalments",
      "stages": [
        "negotiate"
      ],
      "instruction": "Do not describe a plan.",
      "action": "transfer",
      "queue": "restructuring"
    },
    {
      "say": "Can I help you with that first?",
      "outcome": "transferred",
      "reason": "human",
      "id": "human",
      "trigger": "asks for a human or a person",
      "stages": [
        "any"
      ],
      "instruction": "Ask once whether you can help first; transfer only if they insist.",
      "action": "insist_once_then_transfer",
      "queue": "general"
    },
    {
      "say": null,
      "outcome": "transferred",
      "reason": "support",
      "id": "hardship",
      "trigger": "mentions illness, a death in the family or job loss",
      "stages": [
        "negotiate"
      ],
      "instruction": "Say one short sentence of sympathy, make no persuasion attempt, and offer to connect them with the customer support team. If they still name a date or an amount themselves, record the promise under the date and amount rules.",
      "action": "offer_transfer_else_close",
      "queue": "support",
      "else_outcome": "no_promise",
      "else_reason": "hardship",
      "overrides_persuasion": true,
      "per_product_note": "hardship"
    },
    {
      "say": null,
      "outcome": "no_promise",
      "reason": "refused",
      "id": "refused",
      "trigger": "the persuasion attempts for the current product are used up after flat refusals or non-answers",
      "stages": [
        "negotiate"
      ],
      "instruction": "Stop. Do not repeat an offer the customer already refused.",
      "action": "note_and_continue",
      "per_product_note": "refused"
    },
    {
      "say": null,
      "outcome": "no_promise",
      "reason": "refused",
      "id": "not_talk",
      "trigger": "says for the second time that they do not want to talk (after identity is verified)",
      "stages": [
        "negotiate"
      ],
      "times": 2,
      "action": "close",
      "per_product_note": "refused"
    },
    {
      "say": "I could not record your promise.",
      "outcome": "no_promise",
      "reason": "service_error",
      "id": "service_error",
      "trigger": "create_promise failed twice (one retry) for a product",
      "stages": [
        "negotiate"
      ],
      "action": "note_and_continue",
      "per_product_note": "service_error",
      "instruction": "Keep the promises already recorded."
    },
    {
      "say": "Please use the mobile app or visit a branch.",
      "outcome": "not_verified",
      "reason": "failed",
      "id": "failed",
      "trigger": "three wrong security answers in total",
      "stages": [
        "identity"
      ],
      "instruction": "Do not state the debt.",
      "action": "close"
    },
    {
      "say": null,
      "outcome": "not_verified",
      "reason": "declined",
      "id": "declined",
      "trigger": "still declines the security questions after the one explanation, asks a second time what the call is about instead of answering, or says twice before verification that they do not want to talk",
      "stages": [
        "opening",
        "identity"
      ],
      "action": "close"
    },
    {
      "say": null,
      "outcome": "not_reached",
      "reason": "callback",
      "id": "callback",
      "trigger": "someone else answers and gives a callback day and time inside the callback window",
      "stages": [
        "third_party"
      ],
      "instruction": "Call schedule_callback with the date and the time first.",
      "action": "close"
    },
    {
      "say": null,
      "outcome": "not_reached",
      "reason": "no_callback",
      "id": "no_callback",
      "trigger": "someone else answers and the time offered is still outside the callback window after one more ask",
      "stages": [
        "third_party"
      ],
      "instruction": "Do not schedule a callback.",
      "action": "close"
    },
    {
      "say": null,
      "outcome": "not_reached",
      "reason": "wrong_number",
      "id": "wrong_number",
      "trigger": "says the number does not belong to the customer",
      "stages": [
        "opening",
        "third_party"
      ],
      "action": "close"
    },
    {
      "say": "I am sorry for your loss.",
      "outcome": "not_reached",
      "reason": "deceased",
      "id": "deceased",
      "trigger": "says the customer has died",
      "stages": [
        "opening",
        "third_party"
      ],
      "instruction": "Ask nothing else.",
      "action": "close"
    },
    {
      "say": null,
      "outcome": "not_reached",
      "reason": "unclear",
      "id": "unclear",
      "trigger": "identity of the person on the line is still not confirmed after the second ask",
      "stages": [
        "opening"
      ],
      "action": "close"
    }
  ],
  "say_rules": [
    {
      "trigger": "asks if you are a robot or AI",
      "say": "I am Freya Bank's digital assistant.",
      "stages": [
        "any"
      ]
    },
    {
      "trigger": "asks if this call is a scam",
      "say": "You can verify this call by phoning Freya Bank's customer service number.",
      "stages": [
        "any"
      ]
    },
    {
      "trigger": "asks a question you cannot answer from the tools",
      "say": "I do not have that information.",
      "stages": [
        "any"
      ]
    }
  ],
  "confirmation": {
    "question": "Do you confirm?",
    "retries": 1,
    "success_sentence": "You will receive a text message confirming this promise.",
    "failure_event": "service_error",
    "change_note": "You can change it in the mobile app."
  },
  "multi_product": {
    "order": "get_account",
    "ask_all_today_first": true,
    "single_readback": true,
    "shared_date_after_deadline": "cap_to_product_deadline_and_say_so",
    "notes": {
      "enabled": true,
      "reasons": [
        "refused",
        "hardship",
        "dispute",
        "paid",
        "service_error"
      ],
      "on_transfer": "none",
      "timing": "at_close"
    },
    "no_promise_reason": "first_non_paid_note",
    "all_paid_outcome": "paid"
  },
  "closing": {
    "thank_and_goodbye": true
  },
  "outcomes": [
    {
      "outcome": "promise",
      "reason": null,
      "event": "promise_recorded"
    },
    {
      "outcome": "paid",
      "reason": null,
      "event": "paid"
    },
    {
      "outcome": "no_promise",
      "reason": "dispute",
      "event": "dispute"
    },
    {
      "outcome": "transferred",
      "reason": "restructuring",
      "event": "restructuring"
    },
    {
      "outcome": "transferred",
      "reason": "human",
      "event": "human"
    },
    {
      "outcome": "transferred",
      "reason": "support",
      "event": "hardship"
    },
    {
      "outcome": "no_promise",
      "reason": "hardship",
      "event": "hardship"
    },
    {
      "outcome": "no_promise",
      "reason": "refused",
      "event": "refused"
    },
    {
      "outcome": "no_promise",
      "reason": "refused",
      "event": "not_talk"
    },
    {
      "outcome": "no_promise",
      "reason": "service_error",
      "event": "service_error"
    },
    {
      "outcome": "not_verified",
      "reason": "failed",
      "event": "failed"
    },
    {
      "outcome": "not_verified",
      "reason": "declined",
      "event": "declined"
    },
    {
      "outcome": "not_reached",
      "reason": "callback",
      "event": "callback"
    },
    {
      "outcome": "not_reached",
      "reason": "no_callback",
      "event": "no_callback"
    },
    {
      "outcome": "not_reached",
      "reason": "wrong_number",
      "event": "wrong_number"
    },
    {
      "outcome": "not_reached",
      "reason": "deceased",
      "event": "deceased"
    },
    {
      "outcome": "not_reached",
      "reason": "unclear",
      "event": "unclear"
    }
  ],
  "extra_rules": [
    {
      "stage": "opening",
      "text": "If the customer asks a question before confirming (who is calling, robot or AI, scam), answer it first. The confirmation ask that follows is the second ask."
    },
    {
      "stage": "negotiate",
      "text": "Hardship (illness, a death in the family, job loss) comes before persuasion and before restructuring: make no persuasion attempt. If the customer still names a date or an amount themselves, record the promise."
    },
    {
      "stage": "negotiate",
      "text": "One promise per product. A recorded promise cannot be changed or cancelled in the same call."
    },
    {
      "stage": "negotiate",
      "text": "First ask whether the customer can pay all of them today. If not, go through the products one by one in get_account order. Do not ask about today again for each product. Start each product at attempt 1."
    },
    {
      "stage": "negotiate",
      "text": "Persuasion attempts are counted per product."
    },
    {
      "stage": "any",
      "text": "A restructuring request still transfers the call. Promises recorded before the request stay; promises agreed but not yet recorded are not recorded. On any transfer (restructuring, support, human) add no notes at all, before or after it."
    }
  ],
