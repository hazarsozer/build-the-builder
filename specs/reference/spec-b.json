    }
  ],
  "conflicts": [
    {
      "field": "events[hardship]",
      "kept": "Declining the support transfer ends the call: every product without a recorded promise is noted hardship (at close), and the call closes as promise if any promise was recorded, otherwise no_promise / hardship.",
      "overridden": "Brief B is silent on whether declining hardship support on one product ends the call or continues with the other products.",
      "why": "Brief A rule 32 closes on a declined transfer and makes no persuasion attempt; hardship concerns the customer, not one product, so persuading on the remaining products would break rule 32."
    },
    {
      "field": "multi_product.notes",
      "kept": "When at least one promise is recorded, every other product still gets add_note with its reason, and the call closes as promise.",
      "overridden": "Brief B's closing section only describes the reason choice when no promise is recorded.",
      "why": "B rule 8: 'For each product without a promise call add_note'; B rule 8 also says 'The customer may promise some products and refuse others'."
    }
  ],
